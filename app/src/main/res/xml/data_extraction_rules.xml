<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials are sealed to the device by the Android Keystore, so a restored copy elsewhere
     would be undecryptable: only the sync container, already encrypted with the user's own
     passphrase, is portable and therefore the only thing worth carrying. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="cloud/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cloud/" />
    </device-transfer>
</data-extraction-rules>
